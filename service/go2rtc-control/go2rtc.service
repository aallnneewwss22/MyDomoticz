[Unit]
Description=go2rtc - instance de production Domoticz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/go2rtc/go2rtc.env
User=pi
Group=pi
WorkingDirectory=/etc/go2rtc
ExecStart=/usr/local/bin/go2rtc -config ${GO2RTC_CONFIG}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
