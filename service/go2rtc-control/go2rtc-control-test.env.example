# Valeurs spécifiques à l'environnement de test.
# Le fichier réel peut conserver des chemins TOKEN_FILE personnalisés, mais le
# registre doit rester distinct de celui de production.
GO2RTC_API=http://127.0.0.1:1987
GO2RTC_CONFIG=/home/pi/go2rtc-test/go2rtc.yaml
SOURCE_REGISTRY=/var/lib/go2rtc-control-test/cameras.json
SETTINGS_BACKUP_DIR=/var/lib/go2rtc-control-test/settings-backups
CAMERA_SETTINGS_BACKUP_DIR=/var/lib/go2rtc-control-test/camera-settings-backups
PROFILE_LIBRARY_DIR=/var/lib/go2rtc-control-test/profile-library
RECOVERY_KEY_FILE=/var/lib/go2rtc-control-test/recovery/recovery-key.json
TOKEN_FILE=/etc/go2rtc-control-test/token
CONTROL_HOST=127.0.0.1
CONTROL_PORT=1986
TRANSCODE_RTSP_HOST=127.0.0.1
TRANSCODE_RTSP_PORT=8556
